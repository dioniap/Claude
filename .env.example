# ============================================================
# atende-laudos — configuracao
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

PORT=3000

# Endereco publico do sistema (painel e webhook). O Caddy do docker-compose
# emite o certificado HTTPS automaticamente para este dominio.
PUBLIC_URL=https://vendalaudos.simplificapn.com
DOMAIN=vendalaudos.simplificapn.com

# ----- Anthropic (cerebro da IA) -----
# Crie a chave em https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# low | medium | high — medium equilibra custo e qualidade no atendimento
CLAUDE_EFFORT=medium

# ----- WhatsApp Cloud API (Meta) — numero oficial +55 86 95428-7581 -----
# Onde pegar cada valor: veja a secao "Credenciais da Meta" no README.md
WHATSAPP_PHONE_NUMBER_ID=1198577410012883
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
# Token que VOCE inventa; informe o mesmo valor ao configurar o webhook no painel da Meta
WHATSAPP_VERIFY_TOKEN=simplifica-laudos-verify
# App Secret do seu app na Meta (Configuracoes do app > Basico) — valida a assinatura do webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Template aprovado usado nos disparos feitos POR ESTE SISTEMA
# (os disparos do Redrive continuam sendo feitos pelo Redrive normalmente)
WHATSAPP_TEMPLATE_NAME=apresentacao_laudos
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# URL publica da imagem do cabecalho do template (se o template tiver imagem)
WHATSAPP_TEMPLATE_IMAGE_URL=

# Template de UTILIDADE usado para avisar o Dioni fora da janela de 24h
# Crie na Meta um template com 1 variavel no corpo, ex.:
#   "Novo atendimento aguardando no painel: {{1}}"
WHATSAPP_ESCALATION_TEMPLATE_NAME=
WHATSAPP_ESCALATION_TEMPLATE_LANGUAGE=pt_BR

# ----- Redrive (CRM / leads) -----
REDRIVE_BASE_URL=https://api.redrive.com.br
REDRIVE_API_TOKEN=

# ----- Escalonamento para humano (sempre pela API oficial da Meta) -----
ESCALATION_PHONE=5586994110184

# ----- E-mail (Hostinger) — "esqueci minha senha" do painel -----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# use o e-mail comercial da Simplifica na Hostinger
SMTP_USER=contato@simplificapn.com
SMTP_PASS=
MAIL_FROM=contato@simplificapn.com

# ----- G-Click (solicitacoes de laudos periciais) -----
# COPIE os valores do sistema omnichannel da Simplifica (onde a integracao ja funciona).
# Se os caminhos de endpoint forem diferentes, ajuste GCLICK_SOLICITACOES_PATH.
GCLICK_BASE_URL=https://api.gclick.com.br
GCLICK_AUTH_URL=
GCLICK_CLIENT_ID=
GCLICK_CLIENT_SECRET=
GCLICK_USER=
GCLICK_PASS=
GCLICK_EMP_ID=2093
GCLICK_SOLICITACOES_PATH=/solicitacoes

# ----- Comportamento -----
# Segundos aguardando mais mensagens do lead antes de responder
DEBOUNCE_SECONDS=8
# Mensagens de historico enviadas a IA
HISTORY_LIMIT=40
# Ao detectar resposta manual pelo celular, pausa a IA nessa conversa por N horas
# (no painel da para devolver o atendimento para a IA a qualquer momento)
PAUSE_ON_HUMAN_HOURS=12
# Intervalo entre envios no disparo em massa (ms) — 6000 = ~10 msgs/min
DISPATCH_INTERVAL_MS=6000

# ----- Admin -----
# Token para scripts/integracoes usarem as rotas /api/* sem login de usuario
ADMIN_TOKEN=

DB_PATH=./data/atende-laudos.db
